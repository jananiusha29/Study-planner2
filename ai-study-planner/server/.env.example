# Copy this file to .env and adjust as needed.

# Port the API server listens on
PORT=4000

# Allowed origin for the client dev server (Vite default shown)
CLIENT_ORIGIN=http://localhost:5173

# Optional: add your own Anthropic API key to unlock natural-language
# recommendations from Claude on the Insights page. Get one at
# https://console.anthropic.com — leave blank to use the built-in
# rule-based recommendation engine instead (no key required).
ANTHROPIC_API_KEY=
